  "item.everlaartifacts.homa_staff.description_n1": "§9+66.2% Critical Damage",
  "item.everlaartifacts.homa_staff.description_0": "§eAfter loading the Better Combat mod, the attack pattern changes as follows:",
  "item.everlaartifacts.homa_staff.description_1": "§aNormal Attack – Wangsheng Funeral Parlor\u0027s Secret Spear Technique:",
  "item.everlaartifacts.homa_staff.description_2": "§fSwing the staff to deal damage in 6 hits:",
  "item.everlaartifacts.homa_staff.description_3": "§7Hit 1: 83.6% of Attack Power",
  "item.everlaartifacts.homa_staff.description_4": "§7Hit 2: 86.1% of Attack Power",
